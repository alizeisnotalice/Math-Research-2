+       L* out=output+9*written++;out[0]=L(f.f);
+       for(int i=0;i<8;++i){if(ab(f.g[i])>std::numeric_limits<L>::max())return -1;out[i+1]=L(f.g[i]);}
+    }
+    return written;
+}
