+extern "C" void rotate_material(const L* xy, L c,L s,int n,L* dst){
+ for(int i=0;i<n;++i){
+  const L x=xy[2*i],y=xy[2*i+1];
+  dst[2*i]=L((W(x)*c-W(y)*s)/Q);dst[2*i+1]=L((W(x)*s+W(y)*c)/Q);
+ }
